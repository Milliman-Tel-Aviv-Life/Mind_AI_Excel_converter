{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeSet",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "change_set_id": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string"
    },
    "state": {
      "enum": [
        "PROPOSED",
        "APPROVED",
        "APPLIED",
        "REJECTED",
        "FAILED"
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "change_set_id",
    "source_sha256",
    "state",
    "changes"
  ],
  "additionalProperties": false
}