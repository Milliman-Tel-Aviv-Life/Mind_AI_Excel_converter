{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidationReport",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "report_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "WARNING",
        "ERROR",
        "REQUIRES_USER_INPUT",
        "NOT_SUPPORTED"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "status",
    "findings",
    "summary"
  ],
  "additionalProperties": false
}